{
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {"source": "/(.*)", "destination": "/index.html"}
      ]
    },
    "api": {
      "root": ".",
      "framework": "hono",
      "entrypoint": "server.ts",
      "devCommand": "pnpm run api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}