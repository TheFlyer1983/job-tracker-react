{
  "name": "job-tracker-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx src/api/index.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check && pnpm run typecheck",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:seed": "tsx src/db/seed.ts",
    "db:drop": "drizzle-kit reset",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:reset": "pnpm db:drop && pnpm db:migrate && pnpm db:seed",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.7",
    "oxfmt": "^0.64.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "storybook": "^10.5.10",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
